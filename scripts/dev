#!/bin/sh
set -eu

project_dir=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
git_dir=$(git -C "$project_dir" rev-parse --path-format=absolute --git-common-dir)

docker build -t homeplate-dev "$project_dir"
exec docker run --rm \
    --mount "type=bind,source=$project_dir,target=$project_dir" \
    --mount "type=bind,source=$git_dir,target=$git_dir,readonly" \
    --mount type=volume,source=homeplate-platformio,target=/root/.platformio \
    --env GIT_CONFIG_COUNT=1 \
    --env GIT_CONFIG_KEY_0=safe.directory \
    --env "GIT_CONFIG_VALUE_0=$project_dir" \
    --env GIT_OPTIONAL_LOCKS=0 \
    --workdir "$project_dir" \
    homeplate-dev "$@"
